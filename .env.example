# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 git 에 올라가지 않습니다)

# 관리자 로그인 비밀번호 (/admin)
ADMIN_PASSWORD=

# 로그인 쿠키 서명에 쓰는 임의의 긴 문자열. 비워 두면 ADMIN_PASSWORD 로 서명합니다.
# 만들기: openssl rand -hex 32
SESSION_SECRET=

# 배포 주소 (공유 미리보기·sitemap 용). 로컬에서는 비워 두어도 됩니다.
# NEXT_PUBLIC_SITE_URL=https://www.kttaofdc.org
